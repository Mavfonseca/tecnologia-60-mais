---
import { getCollection } from 'astro:content';
import { slugifyTag, getPostTags } from '../utils/tags';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BaseHead from '../components/BaseHead.astro';
import SEO from '../components/SEO.astro';
import '../styles/global.css';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

// Lógica de Destaques
const recomendados = sortedPosts.filter(post => post.data.destaque === true);
const postPrincipal = recomendados[0] || sortedPosts[0];
const postsSecundarios = recomendados.slice(1, 3);

// Lógica para os últimos tutoriais (exclui os que já estão nos destaques)
let ultimosTutoriais = sortedPosts.filter(post => post.id !== postPrincipal?.id && !postsSecundarios.some(p => p.id === post.id));
if (ultimosTutoriais.length === 0) {
  ultimosTutoriais = sortedPosts.slice(1);
}

const todasTags = [...new Set(allPosts.flatMap(post => getPostTags(post.data)))].slice(0, 6);
---

<html lang="pt-br">
  <head>
    <BaseHead title="Início" description="Aprenda tecnologia no seu ritmo com segurança e clareza." />
    <SEO title="Início - Tecnologia 60 Mais" description="Aprenda tecnologia no seu ritmo com segurança e clareza." />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;700;800&display=swap" rel="stylesheet">
  </head>
  <body>
    <Header />
    
    <main>
      <!-- HERO SECTION: BUSCA E VOZ -->
      <section class="hero-section">
        <div class="hero-content">
          <h1>O que você quer aprender hoje?</h1>
          <p>Digite sua dúvida ou use a voz para pesquisar de forma simples e rápida.</p>
          
          <div class="search-container">
            <span class="search-icon">🔍</span>
            <input type="text" placeholder="Ex: Como limpar o celular..." aria-label="Buscar tutorial" />
            <button class="voice-btn">
              <span>🎤</span> Pesquisar por Voz
            </button>
          </div>
        </div>
      </section>

      <div class="container-central">
        <!-- SEÇÃO: RECOMENDADOS -->
        <section class="section-recomendados">
          <div class="section-header">
            <span class="star-icon">⭐</span>
            <h2>Recomendados para Você</h2>
          </div>

          <div class="grid-destaques">
            {postPrincipal && (
              <a href={`/blog/${postPrincipal.id}/`} class="card-principal">
                <div class="image-wrapper">
                  <img src={postPrincipal.data.heroImage} alt={postPrincipal.data.heroAlt} />
                  <span class="badge-principal">Destaque Principal</span>
                </div>
                <div class="card-body">
                  <h3>{postPrincipal.data.title}</h3>
                  <p>{postPrincipal.data.description}</p>
                  <span class="link-action">Ler Artigo Completo <span>→</span></span>
                </div>
              </a>
            )}

            <div class="coluna-secundarios">
              {postsSecundarios.map(post => (
                <a href={`/blog/${post.id}/`} class="card-secundario">
                  <div class="image-wrapper-sm">
                    <img src={post.data.heroImage} alt={post.data.heroAlt} />
                    <span class="badge-destaque">Destaque</span>
                  </div>
                  <div class="card-body-sm">
                    <h4>{post.data.title}</h4>
                    <span class="link-action-sm">Ler Artigo <span>→</span></span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </section>

        <!-- SEÇÃO: TUTORIAIS + SIDEBAR -->
        <div class="layout-split">
          <section class="main-content">
            <div class="section-header">
              <h2>Últimos Tutoriais</h2>
            </div>

            <div class="tutoriais-grid">
              {ultimosTutoriais.map(post => (
                <a href={`/blog/${post.id}/`} class="tutorial-card">
                  <div class="thumb-wrap">
                    <img src={post.data.heroImage} alt={post.data.heroAlt} />
                  </div>
                  <div class="tutorial-info">
                    <span class="pub-date">
                      {new Date(post.data.pubDate).toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' })}
                    </span>
                    <h4>{post.data.title}</h4>
                    <p>{post.data.description}</p>
                  </div>
                </a>
              ))}
            </div>

            <div class="view-all-container">
              <a href="/blog" class="btn-all">Ver Todos os Tutoriais <span>→</span></a>
            </div>
          </section>

          <aside class="sidebar">
            <!-- Widget: Autor/Guia -->
            <div class="widget">
              <div class="author-header">
                <div class="author-avatar">MF</div>
                <h3>Guia do Site</h3>
              </div>
              <p>Aprenda tecnologia no seu ritmo com <strong>Marcos Fonseca</strong>. Segurança, clareza e muita paciência em cada tutorial.</p>
            </div>

            <!-- Widget: Tópicos -->
            <div class="widget">
              <h3>🏷️ Tópicos Populares</h3>
              <div class="tags-container">
                {todasTags.map(tag => (
                  <a href={`/tag/${slugifyTag(tag)}/`} class="tag-link">{tag}</a>
                ))}
              </div>
            </div>

            <!-- Widget: Projetos -->
            <div class="widget">
              <h3>🔗 Conheça Também</h3>
              <ul class="projects-list">
                <li><a href="https://saudecomequilibrio.com.br" target="_blank" rel="noopener">🍏 Saúde com Equilíbrio</a></li>
                <li><a href="https://temperosdonordeste.saudecomequilibrio.com.br" target="_blank" rel="noopener">🌶️ Temperos do Nordeste</a></li>
                <li><a href="https://marcosvfonseca.com" target="_blank" rel="noopener">🌐 Marcos Fonseca</a></li>
              </ul>
            </div>
          </aside>
        </div>
      </div>
    </main>

    <Footer />
  </body>
</html>

<style>
  :root {
    --primary: #000080;
    --primary-light: #1a23e8;
    --surface: #f9f9ff;
    --text-main: #1a1c1e;
    --text-muted: #666;
    --white: #ffffff;
    --accent: #f97316;
  }

  body {
    background-color: var(--surface);
    color: var(--text-main);
    font-family: 'Manrope', sans-serif;
    margin: 0;
  }

  /* HERO SECTION */
  .hero-section {
    background-color: var(--primary);
    color: var(--white);
    padding: 80px 24px;
    text-align: center;
  }

  .hero-content {
    max-width: 800px;
    margin: 0 auto;
  }

  .hero-section h1 {
    font-size: 3rem;
    font-weight: 800;
    margin: 0 0 24px;
    line-height: 1.1;
  }

  .hero-section p {
    font-size: 1.25rem;
    opacity: 0.9;
    margin-bottom: 40px;
  }

  .search-container {
    background: var(--white);
    border-radius: 50px;
    padding: 8px;
    display: flex;
    align-items: center;
    max-width: 650px;
    margin: 0 auto;
    box-shadow: 0 10px 25px rgba(0,0,0,0.2);
  }

  .search-icon {
    padding: 0 16px;
    color: #999;
  }

  .search-container input {
    border: none;
    flex-grow: 1;
    font-size: 1.1rem;
    padding: 12px;
    outline: none;
    color: #333;
  }

  .voice-btn {
    background-color: var(--primary-light);
    color: var(--white);
    border: none;
    padding: 12px 24px;
    border-radius: 50px;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    transition: background 0.3s ease;
  }

  .voice-btn:hover {
    background-color: #0000a0;
  }

  /* CONTAINER CENTRAL */
  .container-central {
    max-width: 1280px;
    margin: 0 auto;
    padding: 60px 24px;
  }

  .section-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 32px;
  }

  .section-header h2 {
    font-size: 2rem;
    font-weight: 700;
    color: var(--primary);
    margin: 0;
  }

  .star-icon {
    font-size: 1.5rem;
  }

  /* GRID DESTAQUES */
  .grid-destaques {
    display: grid;
    grid-template-columns: 1.8fr 1fr;
    gap: 32px;
    margin-bottom: 80px;
  }

  .card-principal, .card-secundario, .tutorial-card {
    text-decoration: none;
    color: inherit;
    background: var(--white);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .card-principal:hover, .card-secundario:hover, .tutorial-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 30px rgba(0,0,0,0.1);
  }

  .image-wrapper {
    position: relative;
    height: 400px;
  }

  .image-wrapper img, .image-wrapper-sm img, .thumb-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .badge-principal {
    position: absolute;
    top: 20px;
    left: 20px;
    background: #c2410c;
    color: var(--white);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 6px 12px;
    border-radius: 4px;
    text-transform: uppercase;
  }

  .card-body {
    padding: 32px;
  }

  .card-body h3 {
    font-size: 1.75rem;
    margin: 0 0 16px;
    line-height: 1.2;
    color: var(--primary);
  }

  .card-body p {
    color: var(--text-muted);
    font-size: 1.1rem;
    line-height: 1.6;
    margin-bottom: 24px;
  }

  .link-action {
    color: var(--primary-light);
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .coluna-secundarios {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .image-wrapper-sm {
    position: relative;
    height: 200px;
  }

  .badge-destaque {
    position: absolute;
    top: 16px;
    left: 16px;
    background: var(--accent);
    color: var(--white);
    font-size: 0.7rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 4px;
    text-transform: uppercase;
  }

  .card-body-sm {
    padding: 24px;
  }

  .card-body-sm h4 {
    font-size: 1.25rem;
    margin: 0 0 12px;
    line-height: 1.3;
  }

  /* LAYOUT SPLIT */
  .layout-split {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 60px;
  }

  .tutoriais-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .tutorial-card {
    display: flex;
    flex-direction: column;
  }

  .thumb-wrap {
    height: 180px;
  }

  .tutorial-info {
    padding: 24px;
  }

  .pub-date {
    font-size: 0.85rem;
    color: #999;
    margin-bottom: 8px;
    display: block;
  }

  .tutorial-info h4 {
    margin: 0 0 12px;
    font-size: 1.15rem;
    line-height: 1.4;
  }

  .tutorial-info p {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .view-all-container {
    margin-top: 48px;
    text-align: center;
  }

  .btn-all {
    display: inline-block;
    background: #000040;
    color: var(--white);
    padding: 16px 40px;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 700;
    transition: background 0.3s;
  }

  .btn-all:hover {
    background: #000;
  }

  /* SIDEBAR */
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .widget {
    background: var(--white);
    padding: 32px;
    border-radius: 24px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.03);
    border: 1px solid rgba(0,0,0,0.05);
  }

  .author-header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
  }

  .author-avatar {
    width: 48px;
    height: 48px;
    background: var(--primary);
    color: var(--white);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
  }

  .widget h3 {
    margin: 0;
    font-size: 1.25rem;
  }

  .widget p {
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
  }

  .tags-container {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }

  .tag-link {
    background: #f1f3f9;
    color: var(--primary);
    padding: 6px 16px;
    border-radius: 50px;
    text-decoration: none;
    font-size: 0.9rem;
    transition: all 0.2s;
  }

  .tag-link:hover {
    background: #e0e7ff;
    color: var(--accent);
  }

  .projects-list {
    list-style: none;
    padding: 0;
    margin: 16px 0 0;
  }

  .projects-list li {
    margin-bottom: 12px;
  }

  .projects-list a {
    text-decoration: none;
    color: var(--text-main);
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 500;
    transition: color 0.2s;
  }

  .projects-list a:hover {
    color: var(--accent);
  }

  /* RESPONSIVO */
  @media (max-width: 1024px) {
    .grid-destaques, .layout-split {
      grid-template-columns: 1fr;
    }
    
    .hero-section h1 {
      font-size: 2.25rem;
    }
  }

  @media (max-width: 768px) {
    .tutoriais-grid {
      grid-template-columns: 1fr;
    }
    
    .image-wrapper {
      height: 250px;
    }
  }
</style>
