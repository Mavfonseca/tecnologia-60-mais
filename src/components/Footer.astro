---
const today = new Date();
---

<footer class="bg-surface-soft border-t border-subtle w-full">
  <div class="max-w-[1440px] mx-auto px-6 md:px-10 py-16 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-10">
    <!-- Coluna 1: Sobre o site -->
    <div class="lg:col-span-2 flex flex-col gap-4">
      <h3 class="font-headline-sm text-headline-sm text-primary">Tecnologia 60 Mais</h3>
      <p class="font-body-md text-[15px] leading-relaxed text-on-surface-variant max-w-sm">
        Tecnologia descomplicada e com paciência. Nosso objetivo é dar autonomia digital com segurança e clareza para a melhor idade.
      </p>
    </div>

    <!-- Coluna 2: Institucional -->
    <div>
      <h4 class="font-label-md text-label-md text-outline uppercase tracking-wider mb-4">Institucional</h4>
      <ul class="flex flex-col gap-3">
        <li><a href="/sobre" class="font-body-md text-[15px] text-on-surface-variant hover:text-primary transition-colors">Sobre Nós</a></li>
        <li><a href="/contato" class="font-body-md text-[15px] text-on-surface-variant hover:text-primary transition-colors">Contato</a></li>
      </ul>
    </div>

    <!-- Coluna 3: Legal -->
    <div>
      <h4 class="font-label-md text-label-md text-outline uppercase tracking-wider mb-4">Legal</h4>
      <ul class="flex flex-col gap-3">
        <li><a href="/termos-de-uso" class="font-body-md text-[15px] text-on-surface-variant hover:text-primary transition-colors">Termos de Uso</a></li>
        <li><a href="/privacidade" class="font-body-md text-[15px] text-on-surface-variant hover:text-primary transition-colors">Privacidade</a></li>
      </ul>
    </div>

    <!-- Coluna 4: Suporte -->
    <div>
      <h4 class="font-label-md text-label-md text-outline uppercase tracking-wider mb-4">Suporte</h4>
      <ul class="flex flex-col gap-3">
        <li><a href="/acessibilidade" class="font-body-md text-[15px] text-on-surface-variant hover:text-primary transition-colors">Acessibilidade</a></li>
        <li><a href="/ajuda" class="font-body-md text-[15px] text-on-surface-variant hover:text-primary transition-colors">Ajuda</a></li>
      </ul>
    </div>

    <!-- Coluna 5: Conheça Também (links preservados dos outros blogs) -->
    <div>
      <h4 class="font-label-md text-label-md text-outline uppercase tracking-wider mb-4">Conheça Também</h4>
      <ul class="flex flex-col gap-3">
        <li>
          <a href="https://saudecomequilibrio.com.br/" target="_blank" rel="noopener noreferrer" class="font-body-md text-[15px] text-on-surface-variant hover:text-primary transition-colors">
            🍏 Saúde com Equilíbrio
          </a>
        </li>
        <li>
          <a href="https://temperosdonordeste.saudecomequilibrio.com.br/" target="_blank" rel="noopener noreferrer" class="font-body-md text-[15px] text-on-surface-variant hover:text-primary transition-colors">
            🌶️ Temperos do Nordeste
          </a>
        </li>
        <li>
          <a href="https://marcosvfonseca.com/" target="_blank" rel="noopener noreferrer" class="font-body-md text-[15px] text-on-surface-variant hover:text-primary transition-colors">
            🌐 Marcos Fonseca
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-subtle">
    <div class="max-w-[1440px] mx-auto px-6 md:px-10 py-6 text-center">
      <p class="font-body-md text-[13px] text-outline">
        &copy; {today.getFullYear()} Tecnologia 60 Mais. Todos os direitos reservados.
      </p>
      <p class="font-body-md text-[13px] text-outline mt-1">
        Desenvolvido com ❤️ por Marcos Fonseca
      </p>
    </div>
  </div>
</footer>