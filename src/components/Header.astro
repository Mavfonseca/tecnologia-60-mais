---
import { SITE_TITLE } from '../consts';

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);

const navLinks = [
  { href: '/', label: 'Início' },
  { href: '/blog', label: 'Tutoriais' },
  { href: '/sobre', label: 'Sobre Nós' },
];
---

<header class="bg-surface border-b border-subtle sticky top-0 z-50">
  <nav class="w-full max-w-[1440px] mx-auto flex items-center justify-between gap-6 px-6 md:px-10 py-4">
    <!-- LOGO -->
    <a href="/" class="flex items-center gap-3 shrink-0">
      <img src="/imagens/logo-cabecalho.webp" alt="Logotipo Tecnologia 60 Mais" class="w-10 h-10 rounded-full object-cover shadow" />
      <span class="font-headline-sm text-headline-sm text-primary hidden sm:inline">{SITE_TITLE || 'Tecnologia 60 Mais'}</span>
    </a>

    <!-- LINKS DESKTOP -->
    <div class="hidden md:flex items-center gap-8 font-label-lg text-label-lg">
      {navLinks.map(link => (
        <a
          href={link.href}
          class:list={[
            'pb-1 border-b-2 transition-colors',
            isActive(link.href)
              ? 'text-secondary border-secondary'
              : 'text-on-surface border-transparent hover:text-secondary',
          ]}
        >
          {link.label}
        </a>
      ))}
    </div>

    <!-- BUSCA DESKTOP -->
    <div class="hidden md:flex items-center bg-surface-container-low border border-outline-variant rounded-full px-4 py-2 w-64 lg:w-80">
      <span class="material-symbols-outlined text-outline mr-2 text-[20px]" style="font-variation-settings: 'FILL' 0;">search</span>
      <input
        type="text"
        placeholder="Buscar no site..."
        aria-label="Buscar no site"
        class="flex-grow bg-transparent border-none focus:ring-0 font-body-md text-on-surface placeholder:text-outline text-[15px] p-0"
        id="header-search-input"
      />
      <button id="header-voice-btn" aria-label="Buscar por voz" class="text-outline hover:text-secondary transition-colors">
        <span class="material-symbols-outlined text-[20px]" style="font-variation-settings: 'FILL' 1;">mic</span>
      </button>
    </div>

    <!-- BOTÃO HAMBÚRGUER MOBILE -->
    <button
      id="mobile-menu-toggle"
      class="md:hidden flex items-center justify-center w-11 h-11 rounded-full hover:bg-surface-container-low transition-colors"
      aria-label="Abrir menu"
      aria-expanded="false"
    >
      <span class="material-symbols-outlined text-primary text-[28px]">menu</span>
    </button>
  </nav>

  <!-- MENU MOBILE (dropdown) -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-subtle bg-surface px-6 py-4 flex flex-col gap-1">
    {navLinks.map(link => (
      <a
        href={link.href}
        class:list={[
          'py-3 font-label-lg text-label-lg rounded-lg px-3',
          isActive(link.href) ? 'text-secondary bg-surface-container-low' : 'text-on-surface',
        ]}
      >
        {link.label}
      </a>
    ))}
    <div class="flex items-center bg-surface-container-low border border-outline-variant rounded-full px-4 py-2 mt-2">
      <span class="material-symbols-outlined text-outline mr-2 text-[20px]">search</span>
      <input
        type="text"
        placeholder="Buscar no site..."
        aria-label="Buscar no site"
        class="flex-grow bg-transparent border-none focus:ring-0 font-body-md text-on-surface placeholder:text-outline text-[15px] p-0"
      />
    </div>
  </div>
</header>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu');
    if (toggleBtn && menu) {
      toggleBtn.addEventListener('click', () => {
        const isOpen = !menu.classList.contains('hidden');
        menu.classList.toggle('hidden');
        toggleBtn.setAttribute('aria-expanded', String(!isOpen));
        toggleBtn.querySelector('.material-symbols-outlined').textContent = isOpen ? 'menu' : 'close';
      });
    }
  });
</script>