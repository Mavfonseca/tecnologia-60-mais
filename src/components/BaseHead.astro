---
interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />

<!-- TAILWIND + DESIGN TOKENS (global, usado em todas as páginas) -->
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries" is:inline></script>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400..800&family=Atkinson+Hyperlegible+Next:wght@400;700&display=swap" rel="stylesheet" />

<script id="tailwind-config" is:inline>
  tailwind.config = {
    darkMode: "class",
    theme: {
      extend: {
        colors: {
          "on-error-container": "#93000a",
          surface: "#f9f9ff",
          error: "#ba1a1a",
          "success-teal": "#006B6B",
          "tertiary-container": "#431000",
          "tertiary-fixed": "#ffdbcf",
          "on-background": "#191b23",
          "surface-container-lowest": "#ffffff",
          primary: "#00003c",
          "on-primary-fixed-variant": "#3239a3",
          "secondary-fixed": "#e0e0ff",
          "on-secondary-fixed": "#000767",
          "primary-fixed-dim": "#bfc2ff",
          "surface-container-high": "#e6e8f2",
          "surface-bright": "#f9f9ff",
          "on-surface-variant": "#464653",
          secondary: "#0019d4",
          "on-secondary": "#ffffff",
          "on-surface": "#191b23",
          "tertiary-fixed-dim": "#ffb59c",
          "surface-tint": "#4b53bc",
          tertiary: "#1c0400",
          "on-error": "#ffffff",
          "on-primary-fixed": "#00006e",
          "on-secondary-fixed-variant": "#001be1",
          "surface-container-low": "#f2f3fd",
          "primary-fixed": "#e0e0ff",
          "outline-variant": "#c6c5d5",
          "surface-container": "#ecedf8",
          "on-tertiary": "#ffffff",
          "surface-variant": "#e0e2ec",
          "surface-container-highest": "#e0e2ec",
          "on-primary": "#ffffff",
          "on-tertiary-fixed": "#380c00",
          "on-primary-container": "#777eea",
          "on-secondary-container": "#cacdff",
          "inverse-primary": "#bfc2ff",
          "border-subtle": "#D1D9E6",
          background: "#f9f9ff",
          "secondary-container": "#2136fe",
          "surface-soft": "#F4F7FA",
          "secondary-fixed-dim": "#bdc2ff",
          "primary-container": "#000080",
          "on-tertiary-container": "#dd6539",
          outline: "#767684",
          "surface-dim": "#d8d9e4",
          "inverse-surface": "#2d3038",
          "on-tertiary-fixed-variant": "#822800",
          "inverse-on-surface": "#eff0fb",
          "error-container": "#ffdad6"
        },
        borderRadius: {
          DEFAULT: "0.25rem",
          lg: "0.5rem",
          xl: "0.75rem",
          full: "9999px"
        },
        fontFamily: {
          "label-md": ["Manrope"],
          "body-md": ["Atkinson Hyperlegible Next"],
          "headline-sm": ["Manrope"],
          "headline-lg-mobile": ["Manrope"],
          "headline-md": ["Manrope"],
          "headline-lg": ["Manrope"],
          "body-lg": ["Atkinson Hyperlegible Next"],
          "label-lg": ["Manrope"]
        },
        fontSize: {
          "label-md": ["14px", { lineHeight: "18px", fontWeight: "600" }],
          "body-md": ["18px", { lineHeight: "28px", fontWeight: "400" }],
          "headline-sm": ["22px", { lineHeight: "30px", fontWeight: "700" }],
          "headline-lg-mobile": ["32px", { lineHeight: "40px", fontWeight: "800" }],
          "headline-md": ["28px", { lineHeight: "36px", fontWeight: "700" }],
          "headline-lg": ["40px", { lineHeight: "52px", letterSpacing: "-0.02em", fontWeight: "800" }],
          "body-lg": ["20px", { lineHeight: "32px", fontWeight: "400" }],
          "label-lg": ["16px", { lineHeight: "20px", letterSpacing: "0.05em", fontWeight: "700" }]
        }
      }
    }
  };
</script>